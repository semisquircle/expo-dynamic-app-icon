{
  "extends": "expo-module-scripts/tsconfig.plugin",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".",
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["app.plugin.ts"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
