{
  "name": "@semisquircle/expo-dynamic-app-icon",
  "version": "58.0.1",
  "description": "Programmatically change the app icon in Expo.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android",
    "build",
    "ios",
    "src",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.plugin.json",
    "build:watch": "expo-module build",
    "prepare": "expo-module prepare",
    "clean": "expo-module clean && rm -rf app.plugin.js",
    "reset": "rm -rf package-lock.json node_modules",
    "expo-module": "expo-module"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-dynamic-app-icon",
    "ExpoDynamicAppIcon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semisquircle/expo-dynamic-app-icon.git"
  },
  "bugs": {
    "url": "https://github.com/semisquircle/expo-dynamic-app-icon/issues"
  },
  "author": "semisquircle <semisquircle@gmail.com> (https://github.com/semisquircle)",
  "license": "MIT",
  "homepage": "https://github.com/semisquircle/expo-dynamic-app-icon#readme",
  "dependencies": {
    "@expo/config-plugins": "^58.0.0",
    "@expo/config-types": "^57.0.2",
    "@expo/image-utils": "^0.11.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo": "^58.0.0",
    "expo-module-scripts": "^56.0.3",
    "react-native": "0.88.0"
  },
  "peerDependencies": {
    "expo": "^58.0.0",
    "react": ">=19",
    "react-native": ">=0.86"
  }
}
