{
  "name": "@semisquircle/expo-dynamic-app-icon",
  "version": "1.0.3",
  "description": "Programmatically change the app icon in Expo.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android",
    "build",
    "ios",
    "src",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "expo-module prepare && tsc -p tsconfig.plugin.json",
    "clean": "expo-module clean && rm -rf app.plugin.js",
    "reset": "rm -rf package-lock.json node_modules"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-dynamic-app-icon",
    "ExpoDynamicAppIcon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semisquircle/expo-dynamic-app-icon.git"
  },
  "bugs": {
    "url": "https://github.com/semisquircle/expo-dynamic-app-icon/issues"
  },
  "author": "Semi Squircle <semisquircle@gmail.com> (https://github.com/semisquircle)",
  "license": "MIT",
  "homepage": "https://github.com/semisquircle/expo-dynamic-app-icon#readme",
  "dependencies": {
    "@expo/image-utils": "^0.8.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.1",
    "expo": "^55.0.20",
    "expo-module-scripts": "^55.0.2",
    "react-native": "0.82.1"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
